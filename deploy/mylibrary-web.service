# Copy to ~/.config/systemd/user/ then:
#   systemctl --user daemon-reload && systemctl --user enable --now mylibrary-web
[Unit]
Description=MyLibrary review UI (localhost:5051)
After=network.target

[Service]
WorkingDirectory=%h/MyLibrary
Environment=MYLIBRARY_CONFIG=%h/MyLibrary/config.ini
ExecStart=/usr/bin/python3 %h/MyLibrary/web/app.py
Restart=on-failure

[Install]
WantedBy=default.target
