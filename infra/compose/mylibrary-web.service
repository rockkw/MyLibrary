# Copy (with the .timer) to ~/.config/systemd/user/ then:
#   systemctl --user daemon-reload && systemctl --user enable --now mylibrary-web
[Unit]
Description=MyLibrary review UI (localhost:5051)
After=network.target

[Service]
WorkingDirectory=%h/src/MyLibrary
Environment=MYLIBRARY_CONFIG=%h/src/MyLibrary/config.ini
ExecStart=%h/.local/bin/mylib serve
Restart=on-failure

[Install]
WantedBy=default.target
