# MyLibrary review UI as a systemd user service. Install: see README "Run as a service".
# The config is found as on the command line: $MYLIBRARY_CONFIG, else the repo's config.ini
# (editable install). Host and port come from it: loopback or Tailscale only, never 0.0.0.0.
[Unit]
Description=MyLibrary review UI (loopback only)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/bin/mylib serve
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
# A restart stops only the UI. A job it started, such as an apply, runs on to the end.
KillMode=process
NoNewPrivileges=yes

[Install]
WantedBy=default.target
